# codeatlas 配置模板 —— 拷贝为 .env 后填写(.env 不入 git)
# 所有 LLM/Embedding 均要求 OpenAI 兼容协议:/v1/chat/completions、/v1/embeddings

LLM_BASE_URL=            # 如 https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=               # 对话模型,如 glm-4.6
LLM_CONTEXT_WINDOW=128000  # 模型窗口,用于上下文预算

EMBED_BASE_URL=          # 可与 LLM 同域
EMBED_API_KEY=
EMBED_MODEL=             # 如 embedding-3 / bge-m3
EMBED_DIM=1024           # 维度校验用,换模型必须改
EMBED_BATCH_SIZE=64
EMBED_QUERY_PREFIX=      # 非对称模型可选,如 bge 系需要
EMBED_PASSAGE_PREFIX=

MAX_CONCURRENCY=4        # API 并发信号量
COST_LIMIT_PER_RUN=50    # 单次命令费用上限(元),超出中断

# ---- 可选:覆盖内置单价(元/1M tokens)。不设则查 config.py 内置表,查不到记 cost=0 ----
# LLM_PRICE_PROMPT=0.6
# LLM_PRICE_COMPLETION=2.2
# EMBED_PRICE=0.5

# ---- 可选:其余关键参数默认值见 src/codeatlas/config.py,均可在此覆盖 ----
# EMBED_BATCH_DELAY_MS=0     # embedding 批间延迟,429 高发时调大
# VECTOR_TOP_K=20
# CONTEXT_TOP_N=8
# SIM_THRESHOLD=0.25
# GRAPH_EXPAND_HOPS=2
